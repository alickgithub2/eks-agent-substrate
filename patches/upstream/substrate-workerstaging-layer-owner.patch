+
+// An image layer's entries keep their tar owner, so an image's private
+// home directory (0700, owned by its non-root user) stays its user's in a
+// network worker's guest. Unprivileged, the test can give files only to its
+// own uid and groups it belongs to: it uses a supplementary group, which
+// extraction without owners would leave as the primary one.
+func TestImageLayerKeepsTarOwner(t *testing.T) {
+	uid, gid := os.Getuid(), os.Getgid()
+	other := -1
+	groups, _ := os.Getgroups()
+	for _, g := range groups {
+		if g != gid {
+			other = g
+			break
+		}
+	}
+	if other < 0 {
+		t.Skip("the test user has no supplementary group to give files to")
+	}
+	data := archiveFixture(t, []*tar.Header{
+		{Name: "fs/", Typeflag: tar.TypeDir, Mode: 0o755, Uid: uid, Gid: gid},
+		{Name: "fs/home/", Typeflag: tar.TypeDir, Mode: 0o700, Uid: uid, Gid: other},
+		{Name: "fs/home/state", Typeflag: tar.TypeReg, Mode: 0o600, Size: 3, Uid: uid, Gid: other},
+	})
+	dir := t.TempDir()
+	if err := extractArtifact(t.Context(), &pb.Artifact{Kind: pb.ArtifactKind_ARTIFACT_KIND_IMAGE_LAYER}, dir, bytes.NewReader(data)); err != nil {
+		t.Fatal(err)
+	}
+	for name, mode := range map[string]os.FileMode{"fs/home": 0o700, "fs/home/state": 0o600} {
+		info, err := os.Lstat(filepath.Join(dir, name))
+		if err != nil {
+			t.Fatal(err)
+		}
+		st := info.Sys().(*syscall.Stat_t)
+		if int(st.Gid) != other || int(st.Uid) != uid {
+			t.Errorf("%s is %d:%d, want %d:%d from its tar header", name, st.Uid, st.Gid, uid, other)
+		}
+		if info.Mode().Perm() != mode {
+			t.Errorf("%s has mode %v, want %v", name, info.Mode().Perm(), mode)
+		}
+	}
+}
